{
  "name": "afriscore-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --port 5175",
    "build": "tsc -b && vite build --configLoader runner && node scripts/prerender.mjs && npm run test:content",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --configLoader runner --host 127.0.0.1 --port 5175",
    "test:content": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.6",
    "@fontsource/space-mono": "^5.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
