# AfriScore API — example environment configuration.
#
# Copy this file to `.env` for local development (the API loads a local .env
# at startup), or export these variables through your process manager /
# container runtime. Never commit a real `.env` file.
#
# Values marked CRITICAL are validated at startup when NODE_ENV=production:
# the process refuses to start if they are missing or too short.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Port the HTTP server listens on. Default: 4000.
PORT=4000

# development | production | test. In production, the required-secret checks
# below are enforced (PostgreSQL is required, secrets must be 32+ characters,
# and a webhook allowlist must be configured).
NODE_ENV=development

# Graceful-shutdown deadline in milliseconds (1000-120000): on SIGTERM/SIGINT
# the server stops accepting connections, waits up to this long for in-flight
# requests, then closes the database pool and exits. Default: 10000.
SHUTDOWN_TIMEOUT_MS=10000

# error | warn | info | debug. Controls structured application log verbosity.
# Default: info.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Where the SQLite database file lives. Only used when DATABASE_URL is NOT
# set (see below) — ignored otherwise. Relative paths resolve against the
# working directory. Default: africore.db in the repository root.
DB_PATH=./afriscore.db

# Set this to switch from SQLite (local dev default) to PostgreSQL
# (recommended for production). Leave blank/unset to use SQLite.
# Production startup refuses anything other than a postgres:// URL.
# Example: postgres://user:password@host:5432/afriscore
DATABASE_URL=

# PostgreSQL pool tuning (ignored on SQLite).
# Maximum pooled connections. Default: 10.
PG_POOL_MAX=10
# Fail instead of hanging when the database is unreachable, in ms. Default: 5000.
PG_CONNECTION_TIMEOUT_MS=5000
# Reclaim idle pooled connections, in ms. Default: 30000.
PG_IDLE_TIMEOUT_MS=30000
# Client-side cap on a single statement, in ms (0 disables). Default: 30000.
PG_QUERY_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Secrets — required in production
# ---------------------------------------------------------------------------

# CRITICAL: bootstrap control-plane credential. Must be at least 32
# characters (generated randomly, not reused anywhere). Required for client
# creation/rotation, consent management, verification, account and invoice
# administration. Send it as the `x-admin-token` header; never expose it to
# browsers or partner applications.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AFRISCORE_ADMIN_TOKEN=

# CRITICAL: salt used to hash national IDs and phone numbers before storage.
# Must be a long random value, generated once and kept secret (rotating it
# invalidates duplicate-detection over existing rows).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ID_HASH_SALT=

# CRITICAL: HMAC key that anchors each subject's trust-ledger head, so a
# database-only attacker cannot rewrite or truncate the chain undetected.
# Use an independent random value (not the ID_HASH_SALT); 32+ characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it makes previously anchored chains fail verification.
LEDGER_HMAC_KEY=

# ---------------------------------------------------------------------------
# Orbit orchestration (async queues)
# ---------------------------------------------------------------------------

# Redis connection for BullMQ. When set, the API only enqueues work and the
# standalone worker process consumes it (npm run worker / node dist/worker.js) —
# this is the multi-process production setup. When unset (default), the API runs
# in-process in-memory workers, which is fine for single-process dev and tests.
# Example: redis://localhost:6379
REDIS_URL=

# ---------------------------------------------------------------------------
# Network / deployment
# ---------------------------------------------------------------------------

# Comma-separated exact HTTPS hostnames allowed to receive webhooks, for
# example: hooks.partner.example,events.other.example
# Production requires at least one entry. Use bare hostnames — no scheme,
# path, port or wildcard. Internal hosts are always rejected.
AFRISCORE_WEBHOOK_ALLOWED_HOSTS=

# Proxy depth for req.ip when deployed behind a load balancer / reverse proxy
# (e.g. 1 for a single proxy hop, or a comma-separated list of trusted
# addresses). Leave unset locally. Without this, every caller may appear as
# the proxy IP and share one rate-limit bucket.
TRUST_PROXY=
# Workspace application (additional to legacy environment variables)
# Required in production: independent 32+ character key for webhook secret encryption.
AFRICORE_ENCRYPTION_KEY=
# Exact HTTPS origin; browser mutation requests must match it.
AFRICORE_PUBLIC_ORIGIN=
# Verified internal users only; comma-separated addresses. Empty denies everyone.
AFRICORE_ENGINEERING_EMAILS=
# Self-service signup/recovery currently development-only until email transport is configured.
# No real M-Pesa initiation or callbacks are enabled.
# Optional signed sandbox callback ingestion (never for a live provider).
AFRICORE_SANDBOX_CALLBACK_SECRET=
# Stage 2 AI explanations (server-side only). OPENAI_API_KEY belongs in an ignored local env/secret store.
AFRICORE_AI_MODEL=gpt-5-mini
AFRICORE_AI_DAILY_REQUEST_LIMIT=50

# Stage 3 sandbox beta. Production issuance/anchoring and external issuer recognition remain disabled.
AFRICORE_PASSPORT_BETA=true
AFRICORE_CREDENTIAL_ISSUANCE=true
AFRICORE_TRUST_SHARING=true
AFRICORE_PUBLIC_VERIFICATION=true
# Verified human operators only; empty denies operations access.
AFRICORE_TRUST_OPERATOR_EMAILS=
# Optional authorized local/Sepolia anchoring. Mainnet is rejected.
AFRICORE_TESTNET_ANCHORING=false
AFRICORE_ANCHOR_RPC=
AFRICORE_ANCHOR_ADDRESS=
AFRICORE_ANCHOR_CHAIN_ID=31337
AFRICORE_ANCHOR_CONFIRMATIONS=1
# Disposable authorized testnet publisher only; never a real-money wallet.
AFRICORE_ANCHOR_PRIVATE_KEY=

# Hosted online evaluation: server-side only, never VITE_*.
# Existing managed provider endpoint; use the same branch as DATABASE_URL.
NEON_AUTH_BASE_URL=
AFRICORE_ENVIRONMENT=development
# Optional origin lock. Set the same independent 32+ character value in the
# Cloudflare secret and backend secret store. Leave unset for localhost.
AFRICORE_GATEWAY_SECRET=
# Hosted restart checks an already migrated schema without rerunning DDL.
# Use verify only after the reviewed migrations have been applied separately.
AFRICORE_MIGRATIONS_MODE=migrate
# Neon migration-only direct URL; never required by the frontend/edge gateway.
DIRECT_URL=
# Cloudflare gateway public variables belong in its Wrangler vars/settings:
# BACKEND_ORIGIN=https://<actual-backend-host>
# NEON_AUTH_ORIGIN=https://<actual-neon-auth-host>
