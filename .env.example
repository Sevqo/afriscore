
# Port the API listens on
PORT=4000

# Where the SQLite database file lives. Only used when DATABASE_URL is
# NOT set (see below) — ignored otherwise.
DB_PATH=./afriscore.db

# Set this to switch from SQLite (local dev default) to PostgreSQL
# (production). Leave blank/unset to use SQLite.
# Example: postgres://user:password@host:5432/afriscore
DATABASE_URL=

# CRITICAL: salt used to hash national IDs and phone numbers before
# storage. Must be a long random value, generated once and kept secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this is not set, the app currently falls back to a hardcoded dev
# value that is public in this repo's history — do not run in
# production without setting this.
ID_HASH_SALT=

# Required for control-plane operations (clients, consent, verification,
# accounts, invoices and sandbox management). Generate a random 32+ character
# secret and send it as x-admin-token. Never expose it in browser code.
AFRISCORE_ADMIN_TOKEN=

# Production webhook delivery requires an exact comma-separated allowlist of
# HTTPS hostnames, for example hooks.partner.example. Never allow internal hosts.
AFRISCORE_WEBHOOK_ALLOWED_HOSTS=
