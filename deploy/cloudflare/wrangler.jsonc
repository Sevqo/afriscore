{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "africore-web",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "BACKEND_ORIGIN": "https://africore-api.onrender.com",
    "NEON_AUTH_ORIGIN": "https://ep-square-mountain-b4ht9gb5.neonauth.c-6.us-east-2.aws.neon.tech"
  },
  "assets": {
    "directory": "../../website/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "enabled": true, "invocation_logs": false } }
}
