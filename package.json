{
  "name": "afriscore-platform",
  "version": "0.1.0",
  "description": "AfriScore programmable business infrastructure for African markets",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "ts-node src/index.ts",
    "dev": "node scripts/dev.js",
    "dev:api": "ts-node src/index.ts",
    "dev:website": "node website/node_modules/vite/bin/vite.js --config website/vite.config.ts --configLoader runner --port 5175 website",
    "worker": "node dist/worker.js",
    "worker:dev": "ts-node src/worker.ts",
    "clean:test": "node scripts/clean-test-db.js",
    "test": "npm run clean:test && npm run build && node --test --test-concurrency=1 \"dist/__tests__/*.test.js\"",
    "test:pg": "npm run build && node --test --test-concurrency=1 \"dist/__tests__/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "validate:openapi": "node scripts/validate-openapi.js",
    "validate:platform": "npm run build && node scripts/platform-openapi.js --check",
    "chain:node": "cd chain && node ../node_modules/hardhat/dist/src/cli.js node --network local --hostname 127.0.0.1",
    "chain:deploy": "node chain/scripts/deploy.mjs",
    "test:chain": "node --test chain/scripts/contracts.test.mjs",
    "verify:credential": "node scripts/verify-credential.mjs",
    "demo:server": "npm run build && npm --prefix website run build && node scripts/demo-server.cjs",
    "demo:web": "npm --prefix website run build && npm --prefix website run preview -- --host 127.0.0.1 --port 4173",
    "check:chain": "npm run build && node chain/scripts/check-local.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^6.4.0",
    "ethers": "^6.17.0",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "pg": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.23.1",
    "hardhat": "^3.21.0",
    "solc": "^0.8.38",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "qs": "^6.16.0",
    "tmp": "0.2.7",
    "uuid": "^11.1.0",
    "zod": "^4.6.7"
  }
}
